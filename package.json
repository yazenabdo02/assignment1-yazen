{
  "name": "status-backend",
  "version": "1.0.0",
  "description": "Status board backend API, deployed to IIS via a self-hosted runner.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest tests/services.test.js",
    "test:api": "jest tests/api.test.js",
    "test:coverage": "jest --coverage",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "json-summary",
      "html",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
